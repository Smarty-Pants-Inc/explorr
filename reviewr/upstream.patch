+        let parent = format!("{}/sub/../explorr-handoff-x", root.display());
+        let doubled = format!("{}//explorr-handoff-x", root.display());
+        let trailing = format!("{handoff}/");
+        for bad in [relative, dotted.as_str(), parent.as_str(), doubled.as_str(), trailing.as_str()]
+        {
+            let mut args = full.clone();
+            let position = args.iter().position(|arg| *arg == "--handoff").unwrap();
+            args[position + 1] = bad;
+            cases.push(args);
+        }
+        // The triple requires --file, and FILE must already be absolute and normalized.
+        cases.push(triple.to_vec());
+        let dotted_file = format!("{}/./doc.md", root.display());
+        let doubled_file = format!("{}//doc.md", root.display());
+        let up_file = format!("{}/x/../doc.md", root.display());
+        for bad in ["doc.md", dotted_file.as_str(), doubled_file.as_str(), up_file.as_str()] {
+            let mut args = vec!["--file", bad];
+            args.extend(triple);
+            cases.push(args);
+        }
+        for args in cases {
+            assert!(ok(&args).is_err(), "{args:?}");
+        }
+    }
