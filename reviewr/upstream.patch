+/// Share validated configuration between startup and lock-preserving recovery shells.
+fn configure_app(app: &mut App, cfg: &Config, plugin_config: PluginConfig) {
     app.set_plugin_config(plugin_config);
     app.set_cli_theme(cfg.theme.clone());
     if let Some(wrap) = cfg.wrap {
