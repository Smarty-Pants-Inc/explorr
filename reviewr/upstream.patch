+        let mut names: Vec<String> = std::fs::read_dir(dir)
+            .unwrap()
+            .map(|entry| entry.unwrap().file_name().to_string_lossy().into_owned())
+            .collect();
+        names.sort();
+        names
+    }
+
+    /// `root/current/A.md` (the sender's identified original), an unrelated
+    /// `root/B.md`, and a sender-created 0700 `root/explorr-handoff-test`.
+    struct Fixture {
+        _dir: tempfile::TempDir,
+        root: PathBuf,
+        parent: PathBuf,
+        file: PathBuf,
+        other: PathBuf,
+        handoff: PathBuf,
+        parent_id: String,
+        file_id: String,
+    }
+
+    fn fixture() -> Fixture {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().canonicalize().unwrap();
+        let parent = root.join("current");
+        std::fs::create_dir(&parent).unwrap();
+        let file = parent.join("A.md");
+        std::fs::write(&file, "# A\nsecond\n").unwrap();
+        let other = root.join("B.md");
+        std::fs::write(&other, "# B\nforeign\n").unwrap();
+        let handoff = root.join("explorr-handoff-test");
+        std::fs::DirBuilder::new().mode(0o700).create(&handoff).unwrap();
+        std::fs::set_permissions(&handoff, std::fs::Permissions::from_mode(0o700)).unwrap();
+        let parent_id = id_of(&parent);
+        let file_id = id_of(&file);
+        Fixture { _dir: dir, root, parent, file, other, handoff, parent_id, file_id }
+    }
+
+    /// The sender's nonce in these fixtures (32 lowercase hex digits).
+    const NONCE: &str = "00112233445566778899aabbccddeeff";
+
+    /// Exactly the argv the Python helper passes: FILE, LINE, the triple and the nonce.
+    fn argv(file: &Path, parent_id: &str, file_id: &str, handoff: &Path) -> Vec<String> {
+        [
+            "--file",
+            file.to_str().unwrap(),
+            "--line",
+            "2",
+            "--expect-parent",
+            parent_id,
+            "--expect-file",
+            file_id,
+            "--handoff",
+            handoff.to_str().unwrap(),
+            "--handoff-nonce",
+            NONCE,
+        ]
+        .iter()
+        .map(|s| (*s).to_string())
+        .collect()
+    }
+
+    /// The real startup route: parse, then the same `ready_app` the binary runs.
+    fn start(args: Vec<String>) -> anyhow::Result<App> {
+        let cfg = Config::parse(args)?;
+        ready_app(&cfg, crate::config::PluginConfig::default())
+    }
+
+    #[test]
+    fn matching_triple_opens_exact_file_and_acknowledges() {
+        let f = fixture();
+        let app = start(argv(&f.file, &f.parent_id, &f.file_id, &f.handoff)).unwrap();
+        assert!(app.is_document());
+        assert_eq!(app.diff_path.as_deref(), f.file.to_str());
+        assert_eq!(app.visible[app.diff_cursor].text(), "second");
+        let ack = std::fs::symlink_metadata(f.handoff.join("ack")).unwrap();
+        assert!(ack.file_type().is_file());
+        assert_eq!(ack.mode() & 0o777, 0o600);
+        assert_eq!(
+            std::fs::read_to_string(f.handoff.join("ack")).unwrap(),
+            format!("{NONCE} {}\n", f.file_id),
+            "the ack carries the nonce from argv and the bound file's DEV:INO"
+        );
+        assert_eq!(listing(&f.handoff), ["ack"]);
+        assert_eq!(listing(&f.parent), ["A.md", "A.md.reviewr.json.lock"]);
+        assert_eq!(std::fs::read_to_string(&f.file).unwrap(), "# A\nsecond\n");
+    }
+
+    /// Each swap happens AFTER the sender identified A (the fixture's ids) and
+    /// BEFORE the receiver starts; every one must refuse with nothing created.
+    #[test]
+    fn swapped_or_mismatched_handoffs_are_refused_with_nothing_created() {
+        let cases = [
+            "absolute-symlink",
+            "relative-symlink",
+            "hard-link",
+            "replaced-regular",
+            "fifo",
+            "missing",
+            "parent-real-dir",
+            "parent-symlink-to-moved",
+            "parent-symlink-elsewhere",
+            "wrong-parent-id",
+            "wrong-file-id",
+            "swapped-ids",
+            "invalidated-handoff",
+            "existing-ack",
+            "group-writable-handoff",
+            "symlink-handoff",
+        ];
+        for case in cases {
+            let f = fixture();
+            let mut parent_id = f.parent_id.clone();
+            let mut file_id = f.file_id.clone();
+            let mut handoff = f.handoff.clone();
+            let moved = f.root.join("moved");
+            match case {
+                "absolute-symlink" => {
+                    std::fs::remove_file(&f.file).unwrap();
+                    symlink(&f.other, &f.file).unwrap();
+                }
+                "relative-symlink" => {
+                    std::fs::remove_file(&f.file).unwrap();
+                    symlink("../B.md", &f.file).unwrap();
+                }
+                "hard-link" => {
+                    std::fs::remove_file(&f.file).unwrap();
+                    std::fs::hard_link(&f.other, &f.file).unwrap();
+                }
+                "replaced-regular" => {
+                    // A different inode; keep a link to A so its number cannot be reused.
+                    std::fs::hard_link(&f.file, f.root.join("A.keep")).unwrap();
+                    std::fs::remove_file(&f.file).unwrap();
+                    std::fs::write(&f.file, "# A\nimpostor\n").unwrap();
+                }
+                "fifo" => {
+                    std::fs::hard_link(&f.file, f.root.join("A.keep")).unwrap();
+                    std::fs::remove_file(&f.file).unwrap();
+                    rustix::fs::mknodat(
+                        rustix::fs::CWD,
+                        &f.file,
+                        rustix::fs::FileType::Fifo,
+                        rustix::fs::Mode::RUSR | rustix::fs::Mode::WUSR,
+                        0,
+                    )
+                    .unwrap();
+                }
+                "missing" => {
+                    std::fs::rename(&f.file, f.root.join("A.keep")).unwrap();
+                }
+                "parent-real-dir" => {
+                    std::fs::rename(&f.parent, &moved).unwrap();
+                    std::fs::create_dir(&f.parent).unwrap();
+                    std::fs::hard_link(moved.join("A.md"), f.parent.join("A.md")).unwrap();
+                }
+                "parent-symlink-to-moved" => {
+                    // Same directory inode, but only reachable by resolving a symlink.
+                    std::fs::rename(&f.parent, &moved).unwrap();
+                    symlink(&moved, &f.parent).unwrap();
+                }
+                "parent-symlink-elsewhere" => {
+                    std::fs::rename(&f.parent, &moved).unwrap();
+                    let elsewhere = f.root.join("elsewhere");
+                    std::fs::create_dir(&elsewhere).unwrap();
+                    std::fs::write(elsewhere.join("A.md"), "# A\nelsewhere\n").unwrap();
+                    symlink(&elsewhere, &f.parent).unwrap();
+                }
+                "wrong-parent-id" => parent_id = id_of(&f.root),
+                "wrong-file-id" => file_id = id_of(&f.other),
+                "swapped-ids" => std::mem::swap(&mut parent_id, &mut file_id),
+                "invalidated-handoff" => {
+                    let closed = f.root.join("explorr-handoff-test.closed");
+                    std::fs::rename(&f.handoff, &closed).unwrap();
+                }
+                "existing-ack" => std::fs::write(f.handoff.join("ack"), b"").unwrap(),
+                "group-writable-handoff" => {
+                    std::fs::set_permissions(&f.handoff, std::fs::Permissions::from_mode(0o770))
+                        .unwrap();
+                }
+                "symlink-handoff" => {
+                    handoff = f.root.join("explorr-handoff-link");
+                    symlink(&f.handoff, &handoff).unwrap();
+                }
+                _ => unreachable!(),
+            }
+            let before_root = listing(&f.root);
+            let before_parent = listing(&f.parent);
+            let before_handoff = f.handoff.exists().then(|| listing(&f.handoff));
+            let error = match start(argv(&f.file, &parent_id, &file_id, &handoff)) {
+                Ok(_) => panic!("{case}: a swapped handoff must be refused"),
+                Err(error) => format!("{error:#}"),
+            };
+            assert!(!error.contains("cannot be combined"), "{case}: parsed as a repo: {error}");
+            assert_eq!(listing(&f.root), before_root, "{case}: {error}");
+            assert_eq!(listing(&f.parent), before_parent, "{case}: no lock or sidecar");
+            if moved.exists() {
+                assert!(!listing(&moved).iter().any(|name| name.contains(".reviewr")), "{case}");
+            }
+            assert_eq!(f.handoff.exists().then(|| listing(&f.handoff)), before_handoff, "{case}");
+            assert_eq!(std::fs::read_to_string(&f.other).unwrap(), "# B\nforeign\n", "{case}");
+        }
+    }
+
+    /// An unrelated aliased spelling is never resolved with the triple: the exact
+    /// FILE spelling is bound, so even the right ids through a symlinked parent fail.
+    #[test]
+    fn triple_never_resolves_a_symlinked_spelling() {
+        let f = fixture();
+        let alias = f.root.join("alias");
+        symlink(&f.parent, &alias).unwrap();
+        let error = start(argv(&alias.join("A.md"), &f.parent_id, &f.file_id, &f.handoff))
+            .err()
+            .expect("a symlinked parent spelling is refused");
+        assert!(!format!("{error:#}").contains("cannot be combined"), "{error:#}");
+        assert_eq!(listing(&f.parent), ["A.md"]);
+        assert!(listing(&f.handoff).is_empty());
+        let link = f.parent.join("link.md");
+        symlink("A.md", &link).unwrap();
+        assert!(start(argv(&link, &f.parent_id, &f.file_id, &f.handoff)).is_err());
+        assert_eq!(listing(&f.parent), ["A.md", "link.md"]);
+        assert!(listing(&f.handoff).is_empty());
+    }
+
+    /// Without the triple, manual `--file` keeps working exactly as before: a symlink
+    /// alias still resolves to the canonical original and no handoff is touched.
+    #[test]
+    fn no_triple_is_unchanged() {
+        let f = fixture();
+        let alias = f.root.join("alias.md");
+        symlink(&f.file, &alias).unwrap();
+        let app = start(vec!["--file".into(), alias.display().to_string()]).unwrap();
+        assert_eq!(app.diff_path.as_deref(), f.file.to_str());
+        assert!(listing(&f.handoff).is_empty());
+        assert_eq!(listing(&f.parent), ["A.md", "A.md.reviewr.json.lock"]);
     }
 }
