+        #[test]
+        fn drop_releases_lease_with_duplicate_descriptor_without_unlocking_next_writer() {
+            let dir = tempfile::tempdir().unwrap();
+            let path = original(dir.path());
+            let (document, _) = Document::open(&path).unwrap();
+            let saved = comments(&path);
+            document.save(&saved).unwrap();
+            let lock_path = append_suffix(&document.sidecar, ".lock");
+            fs::write(&lock_path, b"persistent lock contents").unwrap();
+            let identity = rfs::fstat(&document.lock).unwrap();
+            // A safe duplicate retains the same open file description, just like
+            // a child between fork and exec despite the descriptor's CLOEXEC flag.
+            let inherited = document.lock.try_clone().unwrap();
+            let contender = File::open(&lock_path).unwrap();
+            for _ in 0..2 {
+                assert!(Document::open(&path).is_err());
+                assert!(contender.try_lock().is_err(), "failed open cannot unlock the writer");
+            }
+            drop(document);
+            let (next_writer, loaded) = Document::open(&path)
+                .expect("drop must release the lease even while a duplicate remains open");
+            assert_comments(&loaded, &saved);
+            assert!(same_inode(&identity, &rfs::fstat(&next_writer.lock).unwrap()));
+            assert_eq!(fs::read(&lock_path).unwrap(), b"persistent lock contents");
+            assert!(Document::open(&path).is_err());
+            assert!(contender.try_lock().is_err());
+            drop(inherited);
+            assert!(Document::open(&path).is_err(), "old duplicate cannot unlock next writer");
+            assert!(contender.try_lock().is_err());
+            drop(next_writer);
+            let (_, loaded) = Document::open(&path).unwrap();
+            assert_comments(&loaded, &saved);
+            assert_eq!(fs::read(&lock_path).unwrap(), b"persistent lock contents");
+        }
