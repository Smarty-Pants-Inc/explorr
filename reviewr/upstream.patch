+        }
+
+        /// Both anchor types, both sides, and verbatim multiline/Unicode field content.
+        fn comments(path: &Path) -> CommentStore {
+            let file = path.canonicalize().unwrap().to_str().unwrap().to_owned();
+            let mut comments = CommentStore::new();
+            comments.add(Comment {
+                file: file.clone(),
+                side: Side::Old,
+                start: 7,
+                end: 11,
+                lines: "-old\n context\n\tquoted \"text\"\n".into(),
+                text: "  multiline\n\nreview 🦀\0\r\n".into(),
+                diff_anchored: true,
+            });
+            comments.add(Comment {
+                file,
+                side: Side::New,
+                start: 20,
+                end: 20,
+                lines: " plain content\n".into(),
+                text: String::new(),
+                diff_anchored: false,
+            });
+            comments
+        }
+
+        /// Compare all seven fields and insertion order, not just visible text.
+        fn assert_comments(actual: &CommentStore, expected: &CommentStore) {
+            assert_eq!(actual.iter().collect::<Vec<_>>(), expected.iter().collect::<Vec<_>>());
+        }
