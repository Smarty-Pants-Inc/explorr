+//! Single-document comment snapshots, separate from the git review model.
+//!
+//! The approved document-mode contract persists the seven fields in
+//! `specs/review-model.md` beside the canonical original, without modifying it.
+
+#[cfg(unix)]
+pub use unix::{Document, HandoffDir, HeldOriginal};
+
+#[cfg(unix)]
+mod unix {
+    use std::ffi::OsStr;
+    use std::fs::File;
+    use std::hash::{BuildHasher, Hasher};
+    use std::io::{self, Read, Write};
+    use std::os::unix::fs::{DirBuilderExt, MetadataExt};
+    use std::path::{Path, PathBuf};
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+    use anyhow::{Context, Result, bail};
+    use rustix::fs::{self as rfs, AtFlags, FileType, Mode, OFlags, Stat};
+    use rustix::io::Errno;
+    use serde::{Deserialize, Serialize};
+
+    use crate::config::{Handoff, is_nonce, normalized_absolute};
+    use crate::model::{Comment, CommentStore};
+
+    const SCHEMA_VERSION: u32 = 1;
+    /// Handoff contract v3: the sender polls for `HANDOFF/ack` this often.
+    const ACK_POLL: Duration = Duration::from_millis(20);
+    /// The most of an ack the sender reads; a valid one is far shorter.
+    const MAX_ACK: u64 = 256;
+    static TEMP_SEQUENCE: AtomicU64 = AtomicU64::new(0);
+
+    /// A canonical regular original and its single-writer sidecar lease.
+    ///
+    /// The lock file is deliberately never removed: unlinking it could let another
+    /// writer lock a different inode while this document still holds the old one.
+    /// Drop explicitly unlocks the owned lease: closing only this descriptor would
+    /// retain the lock while a forked child holds the same open file description.
+    #[derive(Debug)]
+    pub struct Document {
+        path: PathBuf,
+        sidecar: PathBuf,
+        // Every sidecar operation uses this directory, not the mutable ancestor path.
+        directory: File,
+        lock: File,
+        // Handoff mode keeps holding the original it bound and acknowledged.
+        _bound_original: Option<File>,
+    }
+
+    /// The identified original, HELD open with its FILE_ID until the receiver has
+    /// acknowledged: no inode can be reused while any descriptor still references it.
+    #[derive(Debug)]
+    pub struct HeldOriginal {
+        file: File,
+        id: String,
+    }
+
+    impl HeldOriginal {
+        /// The held original's FILE_ID (`DEV:INO` from fstat of the held descriptor).
+        pub fn id(&self) -> &str {
+            &self.id
+        }
+
+        /// The held descriptor's `DEV:INO` right now (fstat), for ack validation.
+        fn current_id(&self) -> Result<String> {
+            Ok(format_parent_id(&rfs::fstat(&self.file).context("inspect held original")?))
+        }
+    }
+
+    /// The sender's private per-launch handoff directory (contract v3). It is only ever
+    /// closed through [`HandoffDir::close`], which invalidates it before releasing the
+    /// held original and then removes it. `nonce` is this handoff's 128-bit secret: it
+    /// is passed to the receiver ONLY in its argv (never written into the directory),
+    /// and the receiver's ack must carry it with the bound file's `DEV:INO`.
+    #[derive(Debug)]
+    pub struct HandoffDir {
+        path: PathBuf,
+        nonce: String,
+    }
+
+    /// The receiver-authenticated ack body: the sender's nonce and the receiver's bound
+    /// file `DEV:INO`, exactly as Explorr's `handoff.AckContent` spells it.
+    pub(crate) fn ack_content(nonce: &str, file_id: &str) -> String {
+        format!("{nonce} {file_id}\n")
+    }
+
+    /// A fresh 128-bit nonce from the OS CSPRNG, as 32 lowercase hex digits.
+    fn fresh_nonce() -> Result<String> {
+        let mut raw = [0_u8; 16];
+        File::open("/dev/urandom")
+            .and_then(|mut random| random.read_exact(&mut raw))
+            .context("read handoff nonce from /dev/urandom")?;
+        Ok(raw.iter().fold(String::with_capacity(32), |mut hex, byte| {
+            use std::fmt::Write as _;
+            let _ = write!(hex, "{byte:02x}");
+            hex
+        }))
+    }
+
+    /// Compare without an early exit on the first differing byte.
+    fn constant_time_eq(left: &[u8], right: &[u8]) -> bool {
+        left.len() == right.len()
+            && left.iter().zip(right).fold(0_u8, |acc, (a, b)| acc | (a ^ b)) == 0
+    }
+
+    /// Read `ack` no-follow and non-blocking (a planted symlink or FIFO is refused, never
+    /// followed or waited on), require a regular file, and return at most `MAX_ACK + 1` bytes.
+    fn read_ack(ack: &Path) -> Result<Vec<u8>> {
+        let fd = rfs::open(
+            ack,
+            OFlags::RDONLY | OFlags::NOFOLLOW | OFlags::NONBLOCK | OFlags::CLOEXEC,
+            Mode::empty(),
+        )?;
+        let file = File::from(fd);
+        if FileType::from_raw_mode(rfs::fstat(&file)?.st_mode) != FileType::RegularFile {
+            bail!("ack is not a regular file");
+        }
+        let mut body = Vec::new();
+        file.take(MAX_ACK + 1).read_to_end(&mut body)?;
+        Ok(body)
+    }
+
+    /// Only the agreed canonical snapshot fields are accepted or emitted.
+    #[derive(Debug, Serialize, Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Snapshot {
+        schema_version: u32,
+        document: PathBuf,
+        comments: Vec<Comment>,
+    }
+
+    impl Document {
+        /// Resolve the original, acquire a nonblocking writer lock, and restore comments.
+        /// Missing snapshots start empty; invalid existing snapshots are never repaired.
+        pub fn open(path: &Path) -> Result<(Self, CommentStore)> {
+            Self::open_with(path, None)
+        }
+
+        /// [`Self::open`], or with a sender's [`Handoff`]: bind the exact unresolved
+        /// spelling, require both identities and acknowledge BEFORE any lock or sidecar
+        /// exists, so every refusal leaves nothing written.
+        pub fn open_with(path: &Path, handoff: Option<&Handoff>) -> Result<(Self, CommentStore)> {
+            let (path, directory, bound_original) = if let Some(handoff) = handoff {
+                let (directory, original) = bind_handoff(path, handoff)?;
+                (path.to_path_buf(), directory, Some(original))
+            } else {
+                let path =
+                    path.canonicalize().with_context(|| format!("resolve {}", path.display()))?;
+                path.to_str().context("document path is not UTF-8")?;
+                let parent = path.parent().context("document has no parent directory")?;
+                let directory = open_directory(parent)?;
+                verify_parent(&directory, &path)?;
+                regular_entry(&directory, &path)?.context("document is missing")?;
+                (path, directory, None)
+            };
+            let sidecar = append_suffix(&path, ".reviewr.json");
+            let lock_path = append_suffix(&sidecar, ".lock");
+            let lock = open_lock(&directory, &lock_path)?;
+            lock.try_lock().with_context(|| {
+                format!("document already locked or lock unavailable: {}", path.display())
+            })?;
+            // Construct only after acquisition succeeds, but before fallible
+            // validation, so every owned-lease exit explicitly unlocks it.
+            let document = Self { path, sidecar, directory, lock, _bound_original: bound_original };
+            check_opened_entry(&document.directory, &lock_path, &document.lock)?;
+            let snapshot = read_snapshot(&document.directory, &document.sidecar, &document.path)?;
+            document.verify_location()?;
+            let mut comments = CommentStore::new();
+            if let Some(snapshot) = snapshot {
+                for comment in snapshot.comments {
+                    comments.add(comment);
+                }
+            }
+            Ok((document, comments))
+        }
+
+        /// The absolute canonical original, never its sidecar or an alias.
+        pub fn path(&self) -> &Path {
+            &self.path
+        }
+
+        /// Atomically replace the snapshot while retaining the document's writer lock.
+        /// A write or sync failure leaves the previous snapshot untouched.
+        pub fn save(&self, comments: &CommentStore) -> Result<()> {
+            self.save_with(comments, |file, bytes| file.write_all(bytes))
+        }
+
+        /// Publish through a fresh inode; separating the write permits partial-I/O tests.
+        fn save_with(
+            &self,
+            comments: &CommentStore,
+            write: impl FnOnce(&mut File, &[u8]) -> io::Result<()>,
+        ) -> Result<()> {
+            // Refuse even an externally replaced invalid snapshot rather than overwriting
+            // it. The advisory lock coordinates other reviewr writers, not arbitrary tools.
+            self.verify_location()?;
+            read_snapshot(&self.directory, &self.sidecar, &self.path)?;
+            let snapshot = Snapshot {
+                schema_version: SCHEMA_VERSION,
+                document: self.path.clone(),
+                comments: comments.iter().cloned().collect(),
+            };
+            validate_snapshot(&snapshot, &self.path)?;
+            let mut bytes =
+                serde_json::to_vec_pretty(&snapshot).context("encode document comments")?;
+            bytes.push(b'\n');
+            let mut temp = PendingSnapshot::create(&self.directory, &self.sidecar)?;
+            let file = temp.file.as_mut().context("comment temporary is closed")?;
+            write(file, &bytes)
+                .with_context(|| format!("write comment snapshot {}", temp.path.display()))?;
+            file.sync_all()
+                .with_context(|| format!("sync comment snapshot {}", temp.path.display()))?;
+            // Check again after the write: never knowingly rename over a symlink, a
+            // malformed snapshot, or a snapshot belonging to another document.
+            read_snapshot(&self.directory, &self.sidecar, &self.path)?;
+            check_opened_entry(&temp.directory, &temp.path, file)?;
+            self.verify_location()?;
+            // A later ancestor swap cannot redirect either operand: both are basenames
+            // in the held directory. renameat also never follows a final symlink.
+            rfs::renameat(
+                &temp.directory,
+                entry_name(&temp.path)?,
+                &self.directory,
+                entry_name(&self.sidecar)?,
+            )
+            .with_context(|| format!("replace comment snapshot {}", self.sidecar.display()))?;
+            temp.committed = true;
+            Ok(())
+        }
+
+        /// Read the original's current bytes only through the held parent directory.
+        ///
+        /// A replaced or moved parent is refused (even when the pathname still spells
+        /// the same canonical file), as is a missing, symlinked, or non-regular entry.
+        /// Atomic replacement of the original within the same parent is followed.
+        /// `Ok(None)` means the regular original exceeds the caller's display budget.
+        pub fn read_original(
+            &self,
+            over_budget: impl Fn(usize) -> bool,
+        ) -> Result<Option<Vec<u8>>> {
+            self.verify_location()?;
+            let fd = rfs::openat(
+                &self.directory,
+                entry_name(&self.path)?,
+                OFlags::RDONLY | OFlags::NOFOLLOW | OFlags::NONBLOCK | OFlags::CLOEXEC,
+                Mode::empty(),
+            )
+            .with_context(|| format!("open document {}", self.path.display()))?;
+            let mut file = File::from(fd);
+            check_opened_entry(&self.directory, &self.path, &file)?;
+            let size = rfs::fstat(&file)
+                .with_context(|| format!("inspect document {}", self.path.display()))?
+                .st_size;
+            if usize::try_from(size).map_or(true, &over_budget) {
+                return Ok(None);
+            }
+            let mut bytes = Vec::new();
+            file.read_to_end(&mut bytes)
+                .with_context(|| format!("read document {}", self.path.display()))?;
+            // Refuse content whose parent was replaced while it was being read.
+            self.verify_location()?;
+            Ok(if over_budget(bytes.len()) { None } else { Some(bytes) })
+        }
+
+        /// The held parent's identity per the cross-language PARENT_ID contract:
+        /// unsigned decimal `DEV:INO` from fstat of the held directory, never a path.
+        pub fn parent_id(&self) -> Result<String> {
+            let stat = rfs::fstat(&self.directory).context("inspect held document parent")?;
+            Ok(format_parent_id(&stat))
+        }
+
+        /// Identify and HOLD the original per the cross-language FILE_ID contract: the
+        /// basename opened relative to the HELD parent with NOFOLLOW (so a symlink is
+        /// refused, never resolved to a sibling), required regular and still named by
+        /// that entry, then fstat'd and formatted exactly like PARENT_ID. A FIFO never
+        /// blocks the open. The caller keeps the result until the receiver acknowledges.
+        pub fn file_id(&self) -> Result<HeldOriginal> {
+            self.verify_location()?;
+            let fd = rfs::openat(
+                &self.directory,
+                entry_name(&self.path)?,
+                OFlags::RDONLY | OFlags::NOFOLLOW | OFlags::NONBLOCK | OFlags::CLOEXEC,
+                Mode::empty(),
+            )
+            .with_context(|| format!("open document {}", self.path.display()))?;
+            let file = File::from(fd);
+            let stat = rfs::fstat(&file)
+                .with_context(|| format!("inspect document {}", self.path.display()))?;
+            if FileType::from_raw_mode(stat.st_mode) != FileType::RegularFile {
+                bail!("refusing non-regular original: {}", self.path.display());
+            }
+            check_opened_entry(&self.directory, &self.path, &file)?;
+            Ok(HeldOriginal { id: format_parent_id(&stat), file })
+        }
+
+        /// Permit atomic replacement of the original, but never a different parent,
+        /// a missing/non-regular target, or a lock entry no longer naming our lease.
+        pub fn verify_location(&self) -> Result<()> {
+            verify_parent(&self.directory, &self.path)?;
+            regular_entry(&self.directory, &self.path)?.context("document is missing")?;
+            check_opened_entry(&self.directory, &append_suffix(&self.sidecar, ".lock"), &self.lock)
+        }
+    }
+
+    impl Drop for Document {
+        /// Release only our acquired open-description lease, never a pathname's
+        /// replacement lock or another writer's independently opened descriptor.
+        fn drop(&mut self) {
+            // CLOEXEC closes inherited descriptors at exec, not at fork. Unlock
+            // now rather than waiting for every duplicate to close; never unlink.
+            let _ = self.lock.unlock();
+        }
+    }
+
+    impl HandoffDir {
+        /// Create a fresh private `explorr-handoff-*` directory (mode 0700) under the
+        /// system temp dir, spelled absolute and normalized.
+        pub fn create() -> Result<Self> {
+            Self::create_in(&std::env::temp_dir())
+        }
+
+        /// mkdtemp-equivalent: an exclusive `mkdir` of an unpredictable name, retried
+        /// on collision; mkdir never follows or reuses an existing entry.
+        fn create_in(root: &Path) -> Result<Self> {
+            let root: PathBuf = root.components().collect();
+            for _ in 0..128 {
+                let mut hasher = std::collections::hash_map::RandomState::new().build_hasher();
+                hasher.write_u32(std::process::id());
+                hasher.write_u128(
+                    SystemTime::now().duration_since(UNIX_EPOCH).map_or(0, |d| d.as_nanos()),
+                );
+                hasher.write_u64(TEMP_SEQUENCE.fetch_add(1, Ordering::Relaxed));
+                let path = root.join(format!("explorr-handoff-{:016x}", hasher.finish()));
+                if !path.to_str().is_some_and(normalized_absolute) {
+                    bail!("temporary directory is not absolute and normalized: {}", root.display());
+                }
+                match std::fs::DirBuilder::new().mode(0o700).create(&path) {
+                    Ok(()) => {
+                        return match fresh_nonce() {
+                            Ok(nonce) => Ok(Self { path, nonce }),
+                            Err(error) => {
+                                let _ = std::fs::remove_dir(&path);
+                                Err(error)
+                            }
+                        };
+                    }
+                    Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {}
+                    Err(error) => {
+                        return Err(error)
+                            .with_context(|| format!("create handoff {}", path.display()));
+                    }
+                }
+            }
+            bail!("could not create a unique handoff directory in {}", root.display())
+        }
+
+        /// The HANDOFF argument passed to the launch.
+        pub fn path(&self) -> &Path {
+            &self.path
+        }
+
+        /// This handoff's nonce, passed to the receiver's argv as `--handoff-nonce`.
+        pub fn nonce(&self) -> &str {
+            &self.nonce
+        }
+
+        /// Whether `ack` is exactly [`ack_content`] of this handoff's nonce and the
+        /// fstat `DEV:INO` of the descriptor `held` still holds (which must also be the
+        /// `FILE_ID` passed to the launch). A pre-created marker, a wrong nonce, another
+        /// inode, a symlink or a FIFO is never valid.
+        fn valid_ack(&self, held: &HeldOriginal) -> bool {
+            let Ok(current) = held.current_id() else { return false };
+            if current != held.id() {
+                return false;
+            }
+            let Ok(body) = read_ack(&self.path.join("ack")) else { return false };
+            constant_time_eq(&body, ack_content(&self.nonce, &current).as_bytes())
+        }
+
+        /// Poll every 20 ms until `timeout` for a VALID receiver ack (see `valid_ack`);
+        /// an invalid one is treated exactly like none, so the timeout path applies.
+        pub fn wait_for_ack(&self, timeout: Duration, held: &HeldOriginal) -> bool {
+            let deadline = Instant::now() + timeout;
+            loop {
+                if self.valid_ack(held) {
+                    return true;
+                }
+                let now = Instant::now();
+                if now >= deadline {
+                    return false;
+                }
+                std::thread::sleep(ACK_POLL.min(deadline - now));
+            }
+        }
+
+        /// ALWAYS, in this order: (a) invalidate by renaming HANDOFF to `HANDOFF.closed`,
+        /// (b) release the held original, (c) remove the `.closed` directory. A late
+        /// receiver's ack-by-path then fails, so it can never confirm an open made after
+        /// the inode was released.
+        pub fn close(self, held: HeldOriginal) -> Result<()> {
+            self.close_with(held, |_| {})
+        }
+
+        /// [`Self::close`] with an observer run between invalidation and release.
+        fn close_with(self, held: HeldOriginal, invalidated: impl FnOnce(&Path)) -> Result<()> {
+            let closed = append_suffix(&self.path, ".closed");
+            let renamed = std::fs::rename(&self.path, &closed);
+            if renamed.is_err() {
+                // Still invalidate before releasing: never leave an ackable HANDOFF.
+                let _ = std::fs::remove_dir_all(&self.path);
+            }
+            invalidated(&closed);
+            drop(held);
+            // Remove only what we renamed, never a pre-existing `.closed` entry.
+            let removed = if renamed.is_ok() { std::fs::remove_dir_all(&closed) } else { Ok(()) };
+            renamed.with_context(|| format!("invalidate handoff {}", self.path.display()))?;
+            removed.with_context(|| format!("remove handoff {}", closed.display()))
+        }
+    }
+
+    /// Contract v3 receiver: bind the sender's exact FILE spelling through its held
+    /// parent (never resolving it), require PARENT_ID then FILE_ID, and acknowledge.
+    fn bind_handoff(path: &Path, handoff: &Handoff) -> Result<(File, File)> {
+        let spelled = path.to_str().context("document path is not UTF-8")?;
+        if !normalized_absolute(spelled) {
+            bail!("handoff document must be absolute and normalized: {}", path.display());
+        }
+        let parent = path.parent().context("document has no parent directory")?;
+        // NOFOLLOW: a parent spelled through a final symlink is refused, not resolved.
+        let directory = open_directory(parent)?;
+        let parent_id =
+            format_parent_id(&rfs::fstat(&directory).context("inspect held document parent")?);
+        if parent_id != handoff.parent {
+            bail!(
+                "document parent is not the expected directory: {} (expected {}, found {parent_id})",
+                parent.display(),
+                handoff.parent
+            );
+        }
+        // The bound spelling must also be the one every later location check accepts;
+        // this compares it, and never chooses what is bound.
+        verify_parent(&directory, path)?;
+        let fd = rfs::openat(
+            &directory,
+            entry_name(path)?,
+            OFlags::RDONLY | OFlags::NOFOLLOW | OFlags::NONBLOCK | OFlags::CLOEXEC,
+            Mode::empty(),
+        )
+        .with_context(|| format!("open document {}", path.display()))?;
+        let original = File::from(fd);
+        let stat = rfs::fstat(&original)
+            .with_context(|| format!("inspect document {}", path.display()))?;
+        if FileType::from_raw_mode(stat.st_mode) != FileType::RegularFile {
+            bail!("refusing non-regular original: {}", path.display());
+        }
+        let file_id = format_parent_id(&stat);
+        if file_id != handoff.file {
+            bail!(
+                "document is not the expected file: {} (expected {}, found {file_id})",
+                path.display(),
+                handoff.file
+            );
+        }
+        check_opened_entry(&directory, path, &original)?;
+        acknowledge(&handoff.dir, &handoff.nonce, &file_id)?;
+        Ok((directory, original))
+    }
+
+    /// Create `HANDOFF/ack` (`O_CREAT|O_EXCL|O_WRONLY|O_NOFOLLOW`, 0600) by path, only in a
+    /// private real directory, containing [`ack_content`] of the nonce from our argv and
+    /// the `DEV:INO` of the file we bound. An invalidated (renamed) HANDOFF or an
+    /// existing (possibly planted) ack refuses.
+    fn acknowledge(handoff: &Path, nonce: &str, bound_file_id: &str) -> Result<()> {
+        if !is_nonce(nonce) {
+            bail!("handoff nonce must be 32 lowercase hex digits");
+        }
+        let meta = std::fs::symlink_metadata(handoff)
+            .with_context(|| format!("handoff unavailable: {}", handoff.display()))?;
+        if !meta.file_type().is_dir() {
+            bail!("handoff is not a directory: {}", handoff.display());
+        }
+        if meta.mode() & 0o077 != 0 {
+            bail!("handoff directory is not private: {}", handoff.display());
+        }
+        let ack = handoff.join("ack");
+        let fd = rfs::open(
+            &ack,
+            OFlags::WRONLY | OFlags::CREATE | OFlags::EXCL | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+            Mode::RUSR | Mode::WUSR,
+        )
+        .with_context(|| format!("acknowledge handoff {}", ack.display()))?;
+        let created = rfs::fstat(&fd).with_context(|| format!("inspect {}", ack.display()))?;
+        if created.st_uid != meta.uid() {
+            bail!("handoff directory is not owned by this user: {}", handoff.display());
+        }
+        // One write: the sender rejects a partial ack and keeps polling.
+        File::from(fd)
+            .write_all(ack_content(nonce, bound_file_id).as_bytes())
+            .with_context(|| format!("acknowledge handoff {}", ack.display()))
+    }
+
+    /// Append to the entire filename, including its extension and non-UTF-8 spelling.
+    fn append_suffix(path: &Path, suffix: &str) -> PathBuf {
+        let mut name = path.as_os_str().to_os_string();
+        name.push(suffix);
+        PathBuf::from(name)
+    }
+
+    /// Pass only a final basename to *at operations; ancestors are diagnostic only.
+    fn entry_name(path: &Path) -> Result<&OsStr> {
+        path.file_name().context("document entry has no filename")
+    }
+
+    /// Hold a directory without following its final component as a symlink.
+    fn open_directory(path: &Path) -> Result<File> {
+        let fd = rfs::open(
+            path,
+            OFlags::RDONLY | OFlags::DIRECTORY | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+            Mode::empty(),
+        )
+        .with_context(|| format!("open document parent {}", path.display()))?;
+        Ok(File::from(fd))
+    }
+
+    /// Compare the current canonical parent to our held directory before a transaction
+    /// and its commit. This detects moves, while dirfd operations close the TOCTOU gap.
+    fn verify_parent(directory: &File, document: &Path) -> Result<()> {
+        let parent = document.parent().context("document has no parent directory")?;
+        let canonical = parent.canonicalize().context("resolve current document parent")?;
+        if canonical.as_os_str() != parent.as_os_str() {
+            bail!("document parent path changed: {}", parent.display());
+        }
+        let current = open_directory(&canonical)?;
+        if !same_inode(&rfs::fstat(directory)?, &rfs::fstat(&current)?) {
+            bail!("document parent directory changed: {}", parent.display());
+        }
+        Ok(())
+    }
+
+    /// The shared PARENT_ID/FILE_ID formatter: unsigned decimal `DEV:INO`.
+    /// `st_dev as u64` deliberately matches the contract on platforms with a signed dev_t.
+    #[allow(clippy::unnecessary_cast)]
+    fn format_parent_id(stat: &Stat) -> String {
+        format!("{}:{}", stat.st_dev as u64, stat.st_ino as u64)
+    }
+
+    /// Device and inode together identify the entry without pinning document content.
+    fn same_inode(left: &Stat, right: &Stat) -> bool {
+        left.st_dev == right.st_dev && left.st_ino == right.st_ino
+    }
+
+    /// Inspect a held-directory entry without following symlinks; absent or regular only.
+    fn regular_entry(directory: &File, path: &Path) -> Result<Option<Stat>> {
+        match rfs::statat(directory, entry_name(path)?, AtFlags::SYMLINK_NOFOLLOW) {
+            Ok(stat) if FileType::from_raw_mode(stat.st_mode) == FileType::RegularFile => {
+                Ok(Some(stat))
+            }
+            Ok(_) => bail!("refusing non-regular file or symlink: {}", path.display()),
+            Err(Errno::NOENT) => Ok(None),
+            Err(error) => Err(error).with_context(|| format!("inspect {}", path.display())),
+        }
+    }
+
+    /// Confirm an opened regular file still names the inspected held-directory entry.
+    fn check_opened_entry(directory: &File, path: &Path, file: &File) -> Result<()> {
+        let entry = regular_entry(directory, path)?
+            .with_context(|| format!("file disappeared: {}", path.display()))?;
+        let opened =
+            rfs::fstat(file).with_context(|| format!("inspect open file {}", path.display()))?;
+        if FileType::from_raw_mode(opened.st_mode) != FileType::RegularFile
+            || !same_inode(&entry, &opened)
+        {
+            bail!("file changed or is not regular: {}", path.display());
+        }
+        Ok(())
+    }
+
+    /// Private exclusive creation; NOFOLLOW and EXCL also reject final-entry symlinks.
+    fn create_private(directory: &File, path: &Path) -> rustix::io::Result<File> {
+        // All callers generate a basename-bearing path from the canonical document.
+        let name = path.file_name().ok_or(Errno::INVAL)?;
+        let fd = rfs::openat(
+            directory,
+            name,
+            OFlags::RDWR | OFlags::CREATE | OFlags::EXCL | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+            Mode::RUSR | Mode::WUSR,
+        )?;
+        Ok(File::from(fd))
+    }
+
+    /// Open the persistent lease without truncation, symlink traversal, or FIFO blocking.
+    fn open_lock(directory: &File, path: &Path) -> Result<File> {
+        regular_entry(directory, path)?;
+        let file = match create_private(directory, path) {
+            Ok(file) => file,
+            Err(Errno::EXIST) => {
+                regular_entry(directory, path)?;
+                let fd = rfs::openat(
+                    directory,
+                    entry_name(path)?,
+                    OFlags::RDWR | OFlags::NOFOLLOW | OFlags::CLOEXEC | OFlags::NONBLOCK,
+                    Mode::empty(),
+                )
+                .with_context(|| format!("open document lock {}", path.display()))?;
+                File::from(fd)
+            }
+            Err(error) => {
+                return Err(error)
+                    .with_context(|| format!("create document lock {}", path.display()));
+            }
+        };
+        check_opened_entry(directory, path, &file)?;
+        Ok(file)
+    }
+
+    /// Read and validate a complete snapshot without ever opening it for writing.
+    fn read_snapshot(
+        directory: &File,
+        sidecar: &Path,
+        document: &Path,
+    ) -> Result<Option<Snapshot>> {
+        if regular_entry(directory, sidecar)?.is_none() {
+            return Ok(None);
+        }
+        let fd = rfs::openat(
+            directory,
+            entry_name(sidecar)?,
+            OFlags::RDONLY | OFlags::NOFOLLOW | OFlags::CLOEXEC | OFlags::NONBLOCK,
+            Mode::empty(),
+        )
+        .with_context(|| format!("open comment snapshot {}", sidecar.display()))?;
+        let mut file = File::from(fd);
+        check_opened_entry(directory, sidecar, &file)?;
+        let mut bytes = Vec::new();
+        file.read_to_end(&mut bytes)
+            .with_context(|| format!("read comment snapshot {}", sidecar.display()))?;
+        let snapshot: Snapshot = serde_json::from_slice(&bytes)
+            .with_context(|| format!("invalid comment snapshot {}", sidecar.display()))?;
+        validate_snapshot(&snapshot, document)?;
+        Ok(Some(snapshot))
+    }
+
+    /// Refuse foreign files or unusable anchors without rebasing or rewriting comments.
+    fn validate_snapshot(snapshot: &Snapshot, document: &Path) -> Result<()> {
+        if snapshot.schema_version != SCHEMA_VERSION {
+            bail!("unsupported comment schema version: {}", snapshot.schema_version);
+        }
+        if snapshot.document.as_os_str() != document.as_os_str() {
+            bail!("comment snapshot belongs to another document: {}", snapshot.document.display());
+        }
+        let file = document.to_str().context("document path is not UTF-8")?;
+        for comment in &snapshot.comments {
+            if comment.file != file {
+                bail!("comment belongs to another document: {}", comment.file);
+            }
+            if comment.start == 0 || comment.end < comment.start {
+                bail!("invalid inclusive comment range: {}-{}", comment.start, comment.end);
+            }
+        }
+        Ok(())
+    }
+
+    /// A same-directory exclusive temporary, removed on every pre-rename failure.
+    #[derive(Debug)]
+    struct PendingSnapshot {
+        path: PathBuf,
+        file: Option<File>,
+        // Own a duplicate so cleanup remains bound even if the parent path is moved.
+        directory: File,
+        committed: bool,
+    }
+
+    impl PendingSnapshot {
+        /// Retry collisions without touching another writer's temporary file.
+        fn create(directory: &File, sidecar: &Path) -> Result<Self> {
+            let directory = directory.try_clone().context("retain comment temporary directory")?;
+            for _ in 0..128 {
+                let sequence = TEMP_SEQUENCE.fetch_add(1, Ordering::Relaxed);
+                let path =
+                    append_suffix(sidecar, &format!(".tmp.{}.{sequence}", std::process::id()));
+                match create_private(&directory, &path) {
+                    Ok(file) => {
+                        return Ok(Self { path, file: Some(file), directory, committed: false });
+                    }
+                    Err(Errno::EXIST) => {}
+                    Err(error) => {
+                        return Err(error).with_context(|| {
+                            format!("create comment temporary {}", path.display())
+                        });
+                    }
+                }
+            }
+            bail!("could not create a unique comment temporary for {}", sidecar.display())
+        }
+    }
+
+    impl Drop for PendingSnapshot {
+        fn drop(&mut self) {
+            if !self.committed {
+                // unlinkat does not follow final symlinks or the moved ancestor path.
+                // Do not remove someone else's replacement of our temporary either.
+                if let Some(file) = &self.file {
+                    if check_opened_entry(&self.directory, &self.path, file).is_ok() {
+                        if let Ok(name) = entry_name(&self.path) {
+                            let _ = rfs::unlinkat(&self.directory, name, AtFlags::empty());
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+        use crate::model::Side;
+        use std::fs;
+
+        /// An ordinary original with deliberate extension and nonempty content.
+        fn original(dir: &Path) -> PathBuf {
+            let path = dir.join("notes 日本語.test.md");
+            fs::write(&path, "original body\n").unwrap();
+            path.canonicalize().unwrap()
+        }
+
+        /// Both anchor types, both sides, and verbatim multiline/Unicode field content.
+        fn comments(path: &Path) -> CommentStore {
+            let file = path.canonicalize().unwrap().to_str().unwrap().to_owned();
+            let mut comments = CommentStore::new();
+            comments.add(Comment {
+                file: file.clone(),
+                side: Side::Old,
+                start: 7,
+                end: 11,
+                lines: "-old\n context\n\tquoted \"text\"\n".into(),
+                text: "  multiline\n\nreview 🦀\0\r\n".into(),
+                diff_anchored: true,
+            });
+            comments.add(Comment {
+                file,
+                side: Side::New,
+                start: 20,
+                end: 20,
+                lines: " plain content\n".into(),
+                text: String::new(),
+                diff_anchored: false,
+            });
+            comments
+        }
+
+        /// Compare all seven fields and insertion order, not just visible text.
+        fn assert_comments(actual: &CommentStore, expected: &CommentStore) {
+            assert_eq!(actual.iter().collect::<Vec<_>>(), expected.iter().collect::<Vec<_>>());
+        }
+
+        #[test]
+        fn roundtrip_all_fields_and_canonical_json_without_touching_original() {
+            let dir = tempfile::tempdir().unwrap();
+            let path = original(dir.path());
+            let original_bytes = fs::read(&path).unwrap();
+            let (document, loaded) = Document::open(&path).unwrap();
+            assert!(loaded.is_empty());
+            assert_eq!(document.path(), path.canonicalize().unwrap());
+            let comments = comments(&path);
+            document.save(&comments).unwrap();
+            let json: serde_json::Value =
+                serde_json::from_slice(&fs::read(&document.sidecar).unwrap()).unwrap();
+            assert_eq!(json.as_object().unwrap().len(), 3);
+            assert_eq!(json["schema_version"], 1);
+            assert_eq!(json["document"], document.path().to_str().unwrap());
+            assert_eq!(json["comments"][0].as_object().unwrap().len(), 7);
+            assert_eq!(json["comments"][0]["side"], "old");
+            assert_eq!(json["comments"][1]["side"], "new");
+            assert_eq!(document.sidecar, append_suffix(&path, ".reviewr.json"));
+            drop(document);
+            let (_document, loaded) = Document::open(&path).unwrap();
+            assert_comments(&loaded, &comments);
+            assert_eq!(fs::read(&path).unwrap(), original_bytes);
+        }
