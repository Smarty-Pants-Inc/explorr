+    /// Run the helper and report a launch failure instead of pretending the original was edited.
+    fn edit_original_with(&mut self, helper: &std::ffi::OsStr) -> Result<()> {
+        if self.preview_active() {
+            self.return_from_preview();
+        }
+        let ack_timeout = self.handoff_ack_timeout;
+        let result = (|| {
+            self.ensure_config_ready()?;
+            let (file, line) = self.original_edit_target()?;
+            // The helper contract carries the HELD parent's identity, so only a held
+            // document can be edited; verify it immediately before any launch.
+            let document = self
+                .document
+                .as_ref()
+                .context("edit original requires a held document (document mode)")?;
+            document.verify_location()?;
+            if file != document.path() {
+                bail!("original document target has changed");
+            }
+            // Contract v2: bind the original's own identity too. A parent identity
+            // alone lets a same-parent symlink swap hand the editor a sibling file;
+            // a symlinked, missing, or non-regular original is refused right here.
+            let parent_id = document.parent_id()?;
+            // Contract v3: HOLD the identified original until the receiver acknowledges,
+            // so its inode (FILE_ID) cannot be reused by an unlink-and-recreate.
+            let held = document.file_id()?;
+            let handoff = crate::document::HandoffDir::create()?;
+            let launched = std::process::Command::new(helper)
+                .arg(file)
+                .arg(line.to_string())
+                .arg("1")
+                .arg(parent_id)
+                .arg(held.id())
+                .arg(handoff.path())
+                // The nonce reaches the receiver only through this argv (never HANDOFF).
+                .arg(handoff.nonce())
+                .output()
+                .context("launching original editor");
+            let outcome = match launched {
+                Err(error) => Err(error),
+                Ok(output) if !output.status.success() => Err(anyhow::anyhow!(
+                    "original editor failed: {}",
+                    String::from_utf8_lossy(&output.stderr).trim()
+                )),
+                Ok(_) if handoff.wait_for_ack(ack_timeout, &held) => Ok(()),
+                Ok(_) => Err(anyhow::anyhow!("the editor did not confirm it opened the file")),
+            };
+            // ALWAYS: invalidate HANDOFF, then release the original, then remove it.
+            let closed = handoff.close(held);
+            outcome?;
+            closed
+        })();
+        match &result {
+            Ok(()) => self.status = "opened original in editor".to_string(),
+            Err(error) => self.status = format!("edit original failed: {error:#}"),
+        }
+        result
+    }
