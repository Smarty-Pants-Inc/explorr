+    /// Move `current` aside and recreate it as a REAL directory holding another `A.md`:
+    /// either a hard link to `B.md` or a plain different file. Spelling still matches.
+    fn replace_parent_with_real_directory(root: &std::path::Path, hard_link: bool) {
+        std::fs::rename(root.join("current"), root.join("moved")).unwrap();
+        std::fs::create_dir(root.join("current")).unwrap();
+        let replacement = root.join("current").join("A.md");
+        if hard_link {
+            std::fs::hard_link(root.join("B.md"), &replacement).unwrap();
+        } else {
+            std::fs::write(&replacement, "plain-one\nplain-two\n").unwrap();
+        }
+    }
