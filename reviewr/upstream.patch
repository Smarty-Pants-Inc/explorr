+            }
+        }
+        // Malformed nonces: wrong length, uppercase, non-hex.
+        let long_nonce = format!("{nonce}00");
+        let upper_nonce = nonce.to_uppercase();
+        for bad in ["", &nonce[..30], &long_nonce, &upper_nonce, "zz112233445566778899aabbccddeeff"]
