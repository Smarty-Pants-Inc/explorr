+            args.extend([flag, value]);
+            cases.push(args);
+            let mut missing = vec!["--file", file];
+            missing.extend(triple);
+            let position = missing.iter().position(|arg| *arg == flag).unwrap();
+            missing.remove(position + 1);
+            cases.push(missing);
+        }
+        for bad in
+            ["", "1", "a:b", "1:2:3", "-1:2", "+1:2", " 1:2", "1:", ":2", "18446744073709551616:1"]
+        {
+            for flag in ["--expect-parent", "--expect-file"] {
+                let mut args = full.clone();
+                let position = args.iter().position(|arg| *arg == flag).unwrap();
+                args[position + 1] = bad;
