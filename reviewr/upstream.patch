+/// Recover configuration without reacquiring the live document's lock; carry its state at landing.
+fn recovery_app(cfg: &Config, plugin_config: PluginConfig) -> Result<App> {
+    if let Some(path) = &cfg.document {
+        let repo = path.parent().unwrap_or_else(|| std::path::Path::new("/")).to_path_buf();
+        let mut app = App::blocked(repo, Scope::Uncommitted, None);
+        configure_app(&mut app, cfg, plugin_config);
+        Ok(app)
+    } else {
+        let mut app = ready_app(cfg, plugin_config)?;
+        if let Err(error) = app.reload() {
+            app.status = format!("load failed: {error}");
+        }
+        Ok(app)
+    }
+}
