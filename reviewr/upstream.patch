+    /// Contract v3: the helper receives exactly FILE LINE 1 PARENT_ID FILE_ID HANDOFF NONCE, where
+    /// FILE is the unchanged canonical original and FILE_ID is that entry's own identity.
+    #[cfg(unix)]
+    #[test]
+    fn document_edit_original_passes_exact_parent_and_file_identity() {
+        let (root, path, mut app) = replaced_parent_fixture();
+        let parent = root.path().join("current");
+        let sibling = parent.join("B.md");
+        std::fs::write(&sibling, "sibling-one\n").unwrap();
+        let (helper, args) = recording_helper(root.path());
+        launch_recording_helper(&mut app, &helper);
+        let canonical = path.canonicalize().unwrap();
+        assert_eq!(canonical, path, "FILE is the reviewed spelling, not a resolution");
+        let recorded = std::fs::read_to_string(&args).unwrap();
+        let argv: Vec<&str> = recorded.lines().collect();
+        assert_eq!(
+            argv.len(),
+            7,
+            "exactly FILE LINE COL PARENT_ID FILE_ID HANDOFF NONCE: {argv:?}"
+        );
+        assert!(crate::config::is_nonce(argv[6]), "NONCE is 32 lowercase hex: {argv:?}");
+        assert_eq!(argv[0], canonical.to_str().unwrap());
+        assert_eq!(argv[1], "1");
+        assert_eq!(argv[2], "1");
+        assert_eq!(argv[3], parent_id_of(&parent));
+        assert_eq!(argv[4], file_id_of(&canonical));
+        assert_ne!(argv[4], file_id_of(&sibling), "never the sibling's identity");
+        for id in [argv[3], argv[4]] {
+            let (dev, ino) = id.split_once(':').unwrap();
+            assert!(dev.parse::<u64>().is_ok() && ino.parse::<u64>().is_ok(), "{id}");
+        }
+        assert_eq!(app.status, "opened original in editor");
+        assert_eq!(std::fs::read_to_string(&sibling).unwrap(), "sibling-one\n");
+    }
