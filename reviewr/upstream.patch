+/// Hit only the visible `Edit original` entry, using the same clipped footer lines as paint.
+/// Hidden overflow, modal bars, and a truncated-away label never advertise a clickable action.
+#[must_use]
+pub fn hit_edit_original(area: Rect, app: &App, col: u16, row: u16) -> bool {
+    if !app.is_document() || app.mode != Mode::Normal {
+        return false;
+    }
+    let footer = panes(area, app).status;
+    if !contains(footer, col, row) {
+        return false;
+    }
+    let lines = footer_lines(app, footer.width as usize);
+    let Some(line) = lines.get((row - footer.y) as usize) else { return false };
+    let (key, label) = action_key_label(app, FooterAction::EditOriginal);
+    let label = format!(" {label}");
+    let mut x = footer.x as usize;
+    for (index, span) in line.spans.iter().enumerate() {
+        if span.content == key
+            && line.spans.get(index + 1).is_some_and(|next| next.content == label)
+        {
+            let end = x + span.width() + label.width();
+            // Only claim the whole entry if it painted, not clipped text at the right edge.
+            return end <= (footer.x + footer.width) as usize && (x..end).contains(&(col as usize));
+        }
+        x += span.width();
+    }
+    false
