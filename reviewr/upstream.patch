+    /// A helper that records argv and acknowledges the handoff like a real receiver.
+    #[cfg(unix)]
+    const ACKING_HELPER: &str = "#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$0.args\"\n[ -d \"$6\" ] && printf '%s %s\\n' \"$7\" \"$5\" > \"$6/ack\"\nexit 0\n";
+
+    /// FILE LINE COL PARENT_ID FILE_ID of a recorded argv (HANDOFF is per launch).
+    #[cfg(unix)]
+    fn first_five_lines(args: &str) -> String {
+        args.lines().take(5).map(|line| format!("{line}\n")).collect()
+    }
+
+    /// The cross-language PARENT_ID contract: unsigned decimal `DEV:INO` of a directory.
+    #[cfg(unix)]
+    fn parent_id_of(dir: &std::path::Path) -> String {
+        use std::os::unix::fs::MetadataExt;
+        let metadata = std::fs::metadata(dir).unwrap();
+        format!("{}:{}", metadata.dev(), metadata.ino())
+    }
+
+    /// The cross-language FILE_ID contract: unsigned decimal `DEV:INO` of the entry itself.
+    #[cfg(unix)]
+    fn file_id_of(path: &std::path::Path) -> String {
+        use std::os::unix::fs::MetadataExt;
+        let metadata = std::fs::symlink_metadata(path).unwrap();
+        format!("{}:{}", metadata.dev(), metadata.ino())
+    }
+
+    /// A recording helper outside the reviewed directory; it writes argv only if it runs.
+    #[cfg(unix)]
+    fn recording_helper(dir: &std::path::Path) -> (PathBuf, PathBuf) {
+        use std::os::unix::fs::PermissionsExt;
+        let helper = dir.join("recording-helper");
+        std::fs::write(&helper, ACKING_HELPER).unwrap();
+        std::fs::set_permissions(&helper, std::fs::Permissions::from_mode(0o700)).unwrap();
+        let args = dir.join("recording-helper.args");
+        (helper, args)
+    }
+
+    /// Launch a just-written script helper, retrying only the Linux ETXTBSY race where a
+    /// concurrently forked test child briefly inherits the script's write descriptor.
+    #[cfg(unix)]
+    fn launch_recording_helper(app: &mut App, helper: &std::path::Path) {
+        for _ in 0..100 {
+            match app.edit_original_with(helper.as_os_str()) {
+                Ok(()) => return,
+                Err(error)
+                    if error.chain().any(|cause| {
+                        cause
+                            .downcast_ref::<std::io::Error>()
+                            .is_some_and(|io| io.kind() == std::io::ErrorKind::ExecutableFileBusy)
+                    }) =>
+                {
+                    std::thread::sleep(std::time::Duration::from_millis(10));
+                }
+                Err(error) => panic!("{error:#}"),
+            }
+        }
+        panic!("helper stayed busy");
+    }
+
+    /// A reviewed `current/A.md` beside an unrelated `B.md`, with one saved comment.
+    fn replaced_parent_fixture() -> (tempfile::TempDir, PathBuf, App) {
