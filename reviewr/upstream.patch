+                "comments": []
+            });
+            let mut wrong_schema = valid.clone();
+            wrong_schema["schema_version"] = 2.into();
+            let mut wrong_document = valid.clone();
+            wrong_document["document"] = dir.path().join("other.md").to_str().unwrap().into();
+            let mut missing_field = valid.clone();
+            let mut comment = serde_json::to_value(comments(&path).get(0).unwrap()).unwrap();
+            comment.as_object_mut().unwrap().remove("diff_anchored");
+            missing_field["comments"] = serde_json::json!([comment]);
+            let mut unknown_field = valid.clone();
+            unknown_field["history"] = serde_json::json!([]);
+            for bytes in [
+                b"{bad json".to_vec(),
+                serde_json::to_vec(&wrong_schema).unwrap(),
+                serde_json::to_vec(&wrong_document).unwrap(),
+                serde_json::to_vec(&missing_field).unwrap(),
+                serde_json::to_vec(&unknown_field).unwrap(),
