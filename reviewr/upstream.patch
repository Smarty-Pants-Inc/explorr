+        #[test]
+        fn parent_swap_during_write_cancels_bound_temp_without_touching_replacement() {
+            use std::os::unix::fs::{MetadataExt, symlink};
+
+            // Both a completed write followed by failed precommit validation and
+            // an injected partial-I/O failure must clean up using the original fd.
+            for fail_write in [false, true] {
+                let root = tempfile::tempdir().unwrap();
+                let parent = root.path().join("current");
+                let moved = root.path().join("moved");
+                let other = root.path().join("other");
+                fs::create_dir(&parent).unwrap();
+                fs::create_dir(&other).unwrap();
+                let path = original(&parent);
+                let (document, _) = Document::open(&path).unwrap();
+                let saved = comments(&path);
+                document.save(&saved).unwrap();
+                let old = fs::read(&document.sidecar).unwrap();
+                let mut draft = saved.clone();
+                draft.edit(0, "keep this failed draft".into());
+                let expected_draft = draft.clone();
+                let replacement_original = other.join(path.file_name().unwrap());
+                fs::write(&replacement_original, b"replacement original").unwrap();
+                let mut sentinel = None;
+
+                let result = document.save_with(&draft, |file, bytes| {
+                    // This deterministic hook runs after validation/temp creation
+                    // but BEFORE writing, so pathname cleanup would hit other/.
+                    fs::rename(&parent, &moved)?;
+                    symlink(&other, &parent)?;
+                    let temp = fs::read_dir(&moved)?
+                        .map(|entry| entry.unwrap().path())
+                        .find(|path| path.file_name().unwrap().to_string_lossy().contains(".tmp."))
+                        .unwrap();
+                    let replacement_temp = other.join(temp.file_name().unwrap());
+                    fs::write(&replacement_temp, b"do not remove replacement temp")?;
+                    sentinel = Some(replacement_temp);
+                    let written = if fail_write { &bytes[..bytes.len() / 2] } else { bytes };
+                    file.write_all(written)?;
+                    assert_eq!(file.metadata()?.ino(), fs::metadata(&temp)?.ino());
+                    assert_eq!(
+                        fs::read(&temp)?,
+                        written,
+                        "writes stay in moved original directory"
+                    );
+                    if fail_write {
+                        Err(io::Error::other("injected failure after ancestor swap"))
+                    } else {
+                        Ok(())
+                    }
+                });
+                let error = format!("{:#}", result.unwrap_err());
+                assert!(error.contains(if fail_write {
+                    "injected failure"
+                } else {
+                    "parent path changed"
+                }));
+                assert_comments(&draft, &expected_draft);
+                assert_eq!(
+                    fs::read(moved.join(document.sidecar.file_name().unwrap())).unwrap(),
+                    old
+                );
+                assert_eq!(fs::read_dir(&moved).unwrap().count(), 3, "bound temp was cancelled");
+                assert_eq!(fs::read_dir(&other).unwrap().count(), 2, "no new lock or snapshot");
+                let sentinel = sentinel.unwrap();
+                assert_eq!(fs::read(&sentinel).unwrap(), b"do not remove replacement temp");
+                assert_eq!(fs::read(&replacement_original).unwrap(), b"replacement original");
+                let lock = File::open(
+                    moved.join(append_suffix(&document.sidecar, ".lock").file_name().unwrap()),
+                )
+                .unwrap();
+                assert_eq!(lock.metadata().unwrap().ino(), document.lock.metadata().unwrap().ino());
+                assert!(lock.try_lock().is_err());
+                drop(document);
+                assert_eq!(fs::read(&sentinel).unwrap(), b"do not remove replacement temp");
+                assert_eq!(fs::read_dir(&other).unwrap().count(), 2);
+                lock.try_lock().unwrap();
+            }
+        }
