+    /// Resolve the currently displayed new-side line, never a deleted or renamed old target.
+    fn original_edit_target(&self) -> Result<(PathBuf, u32)> {
+        let path = if let Some(document) = &self.document {
+            document.path().to_path_buf()
+        } else {
+            self.repo.join(self.diff_path.as_ref().context("no source file is open")?)
+        };
+        let canonical = path.canonicalize().context("locating original file")?;
+        if !canonical.is_file() {
