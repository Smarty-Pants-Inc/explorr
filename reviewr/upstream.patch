+/// Directory-bound document persistence is supported only on Unix platforms.
+/// Repository review mode does not depend on this implementation.
+#[cfg(not(unix))]
+#[derive(Debug)]
+pub struct Document {
+    path: std::path::PathBuf,
+}
+
+/// No original can be identified and held on unsupported systems.
+#[cfg(not(unix))]
+#[derive(Debug)]
+pub struct HeldOriginal(());
+
+#[cfg(not(unix))]
+impl HeldOriginal {
+    /// Unreachable: no value is ever constructed off Unix.
+    pub fn id(&self) -> &str {
+        ""
+    }
+}
+
+/// No handoff can be offered on unsupported systems.
+#[cfg(not(unix))]
+#[derive(Debug)]
+pub struct HandoffDir(std::path::PathBuf);
+
+#[cfg(not(unix))]
+impl HandoffDir {
+    /// Refuse: the contract requires a private 0700 directory.
+    pub fn create() -> anyhow::Result<Self> {
+        anyhow::bail!("document mode requires Unix directory-relative filesystem operations")
+    }
+
+    /// The HANDOFF argument.
+    pub fn path(&self) -> &std::path::Path {
+        &self.0
+    }
+
+    /// No nonce exists for an uncreatable handoff.
+    pub fn nonce(&self) -> &str {
+        ""
+    }
+
+    /// Nothing can acknowledge an uncreatable handoff.
+    pub fn wait_for_ack(&self, _timeout: std::time::Duration, _held: &HeldOriginal) -> bool {
+        false
+    }
+
+    /// Nothing to invalidate.
+    pub fn close(self, _held: HeldOriginal) -> anyhow::Result<()> {
+        Ok(())
+    }
+}
+
+#[cfg(not(unix))]
+impl Document {
+    /// Refuse unsupported persistence before reading or creating any sidecar.
+    pub fn open(_path: &std::path::Path) -> anyhow::Result<(Self, crate::model::CommentStore)> {
+        anyhow::bail!("document mode requires Unix directory-relative filesystem operations")
+    }
+
+    /// Refuse handoff binding too: there is no held-parent identity to check.
+    pub fn open_with(
+        _path: &std::path::Path,
+        _handoff: Option<&crate::config::Handoff>,
+    ) -> anyhow::Result<(Self, crate::model::CommentStore)> {
+        anyhow::bail!("document mode requires Unix directory-relative filesystem operations")
+    }
+
+    /// Preserve the document API on platforms whose document mode is unavailable.
+    pub fn path(&self) -> &std::path::Path {
+        &self.path
+    }
+
+    /// Never fall back to unsafe pathname-based persistence on unsupported systems.
+    pub fn save(&self, _comments: &crate::model::CommentStore) -> anyhow::Result<()> {
+        anyhow::bail!("document mode requires Unix directory-relative filesystem operations")
+    }
+
+    /// Never fall back to an unbound pathname read on unsupported systems.
+    pub fn read_original(
+        &self,
+        _over_budget: impl Fn(usize) -> bool,
+    ) -> anyhow::Result<Option<Vec<u8>>> {
+        anyhow::bail!("document mode requires Unix directory-relative filesystem operations")
+    }
+
+    /// No held parent identity exists on unsupported systems.
+    pub fn parent_id(&self) -> anyhow::Result<String> {
+        anyhow::bail!("document mode requires Unix directory-relative filesystem operations")
+    }
+
+    /// No held-parent-bound original identity exists on unsupported systems.
+    pub fn file_id(&self) -> anyhow::Result<HeldOriginal> {
+        anyhow::bail!("document mode requires Unix directory-relative filesystem operations")
+    }
+
+    /// No held parent exists to verify on unsupported systems.
+    pub fn verify_location(&self) -> anyhow::Result<()> {
+        anyhow::bail!("document mode requires Unix directory-relative filesystem operations")
+    }
+}
