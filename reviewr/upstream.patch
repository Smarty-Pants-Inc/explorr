+#[cfg(test)]
+mod document_tests {
+    use super::*;
+    use crate::keymap::{Action, Key};
+
+    /// Build a temporary document and capture the real footer, not an invented hit rectangle.
+    fn document() -> (tempfile::TempDir, App) {
+        let dir = tempfile::tempdir().unwrap();
+        let file = dir.path().join("notes.md");
+        std::fs::write(&file, "# Read me\nA source line\n").unwrap();
+        let app = App::new_document(file, 2).unwrap();
+        (dir, app)
+    }
+
+    /// Render to a simulation backend and return every row as visible terminal text.
+    fn paint(app: &App, width: u16, height: u16) -> Vec<String> {
+        let backend = ratatui::backend::TestBackend::new(width, height);
+        let mut terminal = ratatui::Terminal::new(backend).unwrap();
+        terminal.draw(|frame| render(frame, app)).unwrap();
+        (0..height)
+            .map(|y| (0..width).map(|x| terminal.backend().buffer()[(x, y)].symbol()).collect())
+            .collect()
+    }
+
+    #[test]
+    fn document_footer_painted_key_and_label_are_both_clickable() {
+        let (_dir, app) = document();
+        let area = Rect::new(0, 0, 100, 25);
+        let rows = paint(&app, area.width, area.height);
+        let footer = rows.last().unwrap();
+        let byte = footer.find("E Edit original").expect("visible original editor hint");
+        let start = footer[..byte].width();
+        for col in start..start + "E Edit original".len() {
+            assert!(hit_edit_original(area, &app, col as u16, 24), "column {col}");
+        }
+        assert!(!hit_edit_original(area, &app, start.saturating_sub(1) as u16, 24));
+        assert!(!hit_edit_original(area, &app, (start + "E Edit original".len()) as u16, 24));
+        assert!(!hit_edit_original(area, &app, start as u16, 23));
+        assert!(rows[0].contains("Document · source"));
+        assert!(!rows[0].contains("Changes") && !rows[0].contains("PR"));
+        assert_eq!(hit_header(area, &app, app.keymap(), 2, 0), None);
+    }
+
+    #[test]
+    fn expanded_narrow_footer_uses_the_rebound_original_key_and_actual_row() {
+        let (_dir, mut app) = document();
+        let cfg = tempfile::tempdir().unwrap();
+        std::fs::write(cfg.path().join("config.toml"), "[keybindings]\nedit-original = [\"x\"]\n")
+            .unwrap();
+        app.set_plugin_config(crate::config::plugin_config_in(cfg.path()).unwrap());
+        assert_eq!(app.keymap().hint(Action::EditOriginal), Key::plain('x'));
+        app.keys_expanded = true;
+        let area = Rect::new(0, 0, 40, 25);
+        let rows = paint(&app, area.width, area.height);
+        let (row, start) = rows
+            .iter()
+            .enumerate()
+            .find_map(|(y, text)| text.find("x Edit original").map(|x| (y, text[..x].width())))
+            .unwrap();
+        assert!(hit_edit_original(area, &app, start as u16, row as u16));
+        assert!(hit_edit_original(area, &app, (start + 5) as u16, row as u16));
+        assert!(!hit_edit_original(area, &app, start as u16, 0));
+    }
+
+    #[test]
+    fn clipped_or_modal_footer_never_claims_a_hidden_original_action() {
+        let (_dir, mut app) = document();
+        let narrow = Rect::new(0, 0, 12, 20);
+        assert!(!paint(&app, 12, 20).last().unwrap().contains("Edit original"));
+        assert!((0..12).all(|x| !hit_edit_original(narrow, &app, x, 19)));
+        app.start_comment();
+        let area = Rect::new(0, 0, 100, 25);
+        assert!(!paint(&app, 100, 25).last().unwrap().contains("Edit original"));
+        assert!((0..100).all(|x| !hit_edit_original(area, &app, x, 24)));
+    }
+
+    #[test]
+    fn document_preview_remains_optional_with_source_return_and_original_hint() {
+        let (_dir, mut app) = document();
+        assert!(!app.preview_active());
+        app.toggle_preview();
+        assert!(app.preview_active());
+        let rows = paint(&app, 100, 25);
+        assert!(rows[0].contains("Document · preview"));
+        assert!(rows.last().unwrap().contains("m source"));
+        assert!(rows.last().unwrap().contains("E Edit original"));
+        app.toggle_preview();
+        assert!(!app.preview_active());
+        assert_eq!(app.visible[app.diff_cursor].new_no(), Some(2));
+    }
+}
