+            assert!(error.contains("parent directory changed"), "{error}");
+            assert!(document.verify_location().is_err());
+            assert_eq!(document.parent_id().unwrap(), held_id, "identity stays the held fd's");
+            // And a parent swapped to a symlink at a directory with the same basename.
+            fs::remove_dir_all(&parent).unwrap();
+            let elsewhere = root.path().join("elsewhere");
+            fs::create_dir(&elsewhere).unwrap();
+            fs::write(elsewhere.join(path.file_name().unwrap()), b"elsewhere").unwrap();
+            symlink(&elsewhere, &parent).unwrap();
+            assert!(document.read_original(none).is_err());
+        }
+
+        /// The FILE_ID contract: the original's own `DEV:INO` via the held parent, never
+        /// through a symlink, never a FIFO/missing entry, and the NEW inode after an
+        /// atomic same-parent replacement.
+        #[test]
+        fn file_id_is_the_held_parent_bound_regular_original() {
+            use std::os::unix::fs::{MetadataExt, symlink};
+            let id_of = |path: &Path| {
+                let meta = fs::symlink_metadata(path).unwrap();
+                format!("{}:{}", meta.dev(), meta.ino())
+            };
+            let dir = tempfile::tempdir().unwrap();
+            let path = original(dir.path());
+            let sibling = dir.path().join("B.md");
+            fs::write(&sibling, b"sibling").unwrap();
+            let (document, _) = Document::open(&path).unwrap();
+            let first = document.file_id().unwrap().id().to_owned();
+            assert_eq!(first, id_of(&path));
+            assert_ne!(first, id_of(&sibling));
+            assert_ne!(first, document.parent_id().unwrap());
+
+            // Same-parent atomic replacement yields the NEW inode.
+            let temp = dir.path().join("editor.tmp");
+            fs::write(&temp, b"edited").unwrap();
+            let replacement = id_of(&temp);
+            fs::rename(&temp, &path).unwrap();
+            let second = document.file_id().unwrap().id().to_owned();
+            assert_eq!(second, replacement);
+            assert_ne!(second, first);
+
+            // A same-parent symlink to a sibling (absolute or relative) is refused.
+            for target in [sibling.as_path(), Path::new("B.md")] {
+                fs::remove_file(&path).unwrap();
+                symlink(target, &path).unwrap();
+                assert!(document.file_id().is_err(), "symlink to {}", target.display());
+            }
+            // A FIFO never blocks and is refused; a missing original is refused.
+            fs::remove_file(&path).unwrap();
+            rustix::fs::mknodat(rustix::fs::CWD, &path, FileType::Fifo, Mode::RUSR | Mode::WUSR, 0)
+                .unwrap();
+            assert!(document.file_id().is_err(), "FIFO");
+            fs::remove_file(&path).unwrap();
+            assert!(document.file_id().is_err(), "missing");
+            assert_eq!(fs::read(&sibling).unwrap(), b"sibling");
+            fs::write(&path, b"restored").unwrap();
+            assert_eq!(document.file_id().unwrap().id(), id_of(&path));
+        }
+
+        /// Round-4 P2: after identification, unlink A and create a new A. While the
+        /// identified file is held its inode cannot be reused, so the new A differs.
+        #[test]
+        fn identified_inode_is_not_reused_while_held() {
+            use std::os::unix::fs::MetadataExt;
+            let dir = tempfile::tempdir().unwrap();
+            let path = original(dir.path());
+            let (document, _) = Document::open(&path).unwrap();
+            let held = document.file_id().unwrap();
+            fs::remove_file(&path).unwrap();
+            fs::write(&path, b"replacement").unwrap();
+            let meta = fs::symlink_metadata(&path).unwrap();
+            let replacement = format!("{}:{}", meta.dev(), meta.ino());
+            assert_ne!(replacement, held.id(), "inode reused while the original was identified");
+            // Control: without a hold this filesystem may hand the number straight back.
+            // Informational only; it is not an error when the filesystem does not reuse.
+            let unheld = replacement;
+            fs::remove_file(&path).unwrap();
+            fs::write(&path, b"second replacement").unwrap();
+            let meta = fs::symlink_metadata(&path).unwrap();
+            let reused = format!("{}:{}", meta.dev(), meta.ino()) == unheld;
+            eprintln!("inode reuse without a hold on this filesystem: {reused}");
+            drop(held);
+        }
+
+        /// Close steps run in contract order: HANDOFF is already renamed to `.closed`
+        /// (so an ack by path fails) while the original is STILL held; afterwards the
+        /// held inode is released and the `.closed` directory is gone.
+        #[test]
+        fn handoff_close_invalidates_before_releasing_then_removes() {
+            use std::os::unix::fs::{MetadataExt, PermissionsExt};
+            let dir = tempfile::tempdir().unwrap();
+            let path = original(dir.path());
+            let (document, _) = Document::open(&path).unwrap();
+            let root = dir.path().canonicalize().unwrap();
+            let handoff = HandoffDir::create_in(&root).unwrap();
+            let created = fs::symlink_metadata(handoff.path()).unwrap();
+            assert!(created.file_type().is_dir());
+            assert_eq!(created.permissions().mode() & 0o777, 0o700);
+            let name = handoff.path().file_name().unwrap().to_str().unwrap().to_owned();
+            assert!(name.starts_with("explorr-handoff-"), "{name}");
+            let other = HandoffDir::create_in(&root).unwrap();
+            assert_ne!(other.path(), handoff.path(), "fresh per launch");
+            let held = document.file_id().unwrap();
+            let held_id = held.id().to_owned();
+            let nonce = handoff.nonce().to_owned();
+            let spelled = handoff.path().to_path_buf();
+            let mut observed = false;
+            handoff
+                .close_with(held, |closed| {
+                    observed = true;
+                    assert!(!spelled.exists(), "HANDOFF invalidated first");
+                    assert!(closed.is_dir());
+                    assert!(
+                        acknowledge(&spelled, &nonce, &held_id).is_err(),
+                        "ack by path now fails"
+                    );
+                    fs::remove_file(&path).unwrap();
+                    fs::write(&path, b"racer").unwrap();
+                    let meta = fs::symlink_metadata(&path).unwrap();
+                    assert_ne!(
+                        format!("{}:{}", meta.dev(), meta.ino()),
+                        held_id,
+                        "original still held during invalidation"
+                    );
+                })
+                .unwrap();
+            assert!(observed);
+            assert!(!spelled.exists());
+            assert!(!append_suffix(&spelled, ".closed").exists());
+            let held = document.file_id().unwrap();
+            other.close(held).unwrap();
+            assert_eq!(fs::read_dir(&root).unwrap().count(), 2, "original and its lock only");
+        }
+
+        /// A pre-existing `.closed` entry is never adopted or removed; HANDOFF itself is
+        /// still removed before release and the failure is reported.
+        #[test]
+        fn handoff_close_failure_still_removes_handoff() {
+            let dir = tempfile::tempdir().unwrap();
+            let path = original(dir.path());
+            let (document, _) = Document::open(&path).unwrap();
+            let root = dir.path().canonicalize().unwrap();
+            let handoff = HandoffDir::create_in(&root).unwrap();
+            let spelled = handoff.path().to_path_buf();
+            let squatter = append_suffix(&spelled, ".closed");
+            fs::write(&squatter, b"not ours").unwrap();
+            fs::write(spelled.join("ack"), b"").unwrap();
+            let error = handoff.close(document.file_id().unwrap()).unwrap_err();
+            assert!(format!("{error:#}").contains("invalidate handoff"), "{error:#}");
+            assert!(!spelled.exists(), "HANDOFF removed even though rename failed");
+            assert_eq!(fs::read(&squatter).unwrap(), b"not ours");
+        }
+
+        /// The forged-ack P2: `wait_for_ack` accepts only the receiver-authenticated ack,
+        /// `NONCE DEV:INO` of this handoff's nonce and the held original. A pre-created
+        /// marker, a missing or wrong nonce, another inode, trailing bytes, a symlink or a
+        /// directory are treated exactly like no ack (the full timeout), and the genuine
+        /// receiver's exclusive ack then fails closed.
+        #[test]
+        fn wait_for_ack_requires_the_nonce_bound_to_the_held_inode() {
+            use std::os::unix::fs::MetadataExt;
+            type Plant = fn(&Path, &str, &str, &str);
+            let dir = tempfile::tempdir().unwrap();
+            let path = original(dir.path());
+            let (document, _) = Document::open(&path).unwrap();
+            let root = dir.path().canonicalize().unwrap();
+            let other = root.join("other.md");
+            fs::write(&other, b"other").unwrap();
+            let other_meta = fs::symlink_metadata(&other).unwrap();
+            let other_id = format!("{}:{}", other_meta.dev(), other_meta.ino());
+            let short = Duration::from_millis(60);
+            let cases: [(&str, Plant); 7] = [
+                ("empty marker", |ack, _, _, _| fs::write(ack, b"").unwrap()),
+                ("no nonce", |ack, _, id, _| fs::write(ack, format!("{id}\n")).unwrap()),
+                ("wrong nonce", |ack, _, id, _| {
+                    fs::write(ack, ack_content("ffeeddccbbaa99887766554433221100", id)).unwrap();
+                }),
+                ("right nonce, wrong dev:ino", |ack, nonce, _, other| {
+                    fs::write(ack, ack_content(nonce, other)).unwrap();
+                }),
+                ("trailing bytes", |ack, nonce, id, _| {
+                    fs::write(ack, format!("{}x", ack_content(nonce, id))).unwrap();
+                }),
+                ("symlink to a valid ack", |ack, nonce, id, _| {
+                    let elsewhere = ack.with_file_name("elsewhere");
+                    fs::write(&elsewhere, ack_content(nonce, id)).unwrap();
+                    std::os::unix::fs::symlink(&elsewhere, ack).unwrap();
+                }),
+                ("directory", |ack, _, _, _| fs::create_dir(ack).unwrap()),
+            ];
+            for (name, plant) in cases {
+                let handoff = HandoffDir::create_in(&root).unwrap();
+                let held = document.file_id().unwrap();
+                plant(&handoff.path().join("ack"), handoff.nonce(), held.id(), &other_id);
+                let start = Instant::now();
+                assert!(!handoff.wait_for_ack(short, &held), "{name} accepted");
+                assert!(start.elapsed() >= short, "{name} ended the wait early");
+                assert!(
+                    acknowledge(handoff.path(), handoff.nonce(), held.id()).is_err(),
+                    "{name}: genuine ack over a planted one"
+                );
+                handoff.close(held).unwrap();
+            }
+            // The genuine receiver's ack is accepted at once; the sender itself wrote
+            // nothing into HANDOFF, and every handoff draws a fresh well-formed nonce.
+            let handoff = HandoffDir::create_in(&root).unwrap();
+            let next = HandoffDir::create_in(&root).unwrap();
+            assert!(is_nonce(handoff.nonce()) && is_nonce(next.nonce()));
+            assert_ne!(handoff.nonce(), next.nonce());
+            assert_eq!(fs::read_dir(handoff.path()).unwrap().count(), 0);
+            let held = document.file_id().unwrap();
+            acknowledge(handoff.path(), handoff.nonce(), held.id()).unwrap();
+            let start = Instant::now();
+            assert!(handoff.wait_for_ack(Duration::from_secs(5), &held));
+            assert!(start.elapsed() < Duration::from_secs(2));
+            assert_eq!(
+                fs::read(handoff.path().join("ack")).unwrap(),
+                ack_content(handoff.nonce(), held.id()).into_bytes()
+            );
+            handoff.close(held).unwrap();
+            next.close(document.file_id().unwrap()).unwrap();
+        }
+
+        #[cfg(unix)]
+        #[test]
+        fn private_snapshot_and_lock_permissions() {
+            use std::os::unix::fs::PermissionsExt;
+            let dir = tempfile::tempdir().unwrap();
+            let path = original(dir.path());
+            let (document, _) = Document::open(&path).unwrap();
+            document.save(&comments(&path)).unwrap();
+            for private in [&document.sidecar, &append_suffix(&document.sidecar, ".lock")] {
+                assert_eq!(fs::metadata(private).unwrap().permissions().mode() & 0o777, 0o600);
+            }
+        }
+    }
+}
