+        #[test]
+        fn moved_parent_replacements_refuse_save_preserving_draft_and_lock() {
+            use std::os::unix::fs::{MetadataExt, symlink};
+
+            // The symlink variant is the reported exploit; a real replacement
+            // directory additionally proves we compare dev/ino, not just spelling.
+            for replace_with_symlink in [true, false] {
+                let root = tempfile::tempdir().unwrap();
+                let parent = root.path().join("current");
+                let moved = root.path().join("moved");
+                let other = root.path().join("other");
+                fs::create_dir(&parent).unwrap();
+                fs::create_dir(&other).unwrap();
+                let path = original(&parent);
+                let (document, _) = Document::open(&path).unwrap();
+                let saved = comments(&path);
+                document.save(&saved).unwrap();
+                let old = fs::read(&document.sidecar).unwrap();
+                let lock_path = append_suffix(&document.sidecar, ".lock");
+                let old_lock = fs::metadata(&lock_path).unwrap();
+                let mut draft = saved.clone();
+                assert!(draft.edit(0, "unsaved draft\nverbatim  ".into()));
+                let expected_draft = draft.clone();
+
+                fs::rename(&parent, &moved).unwrap();
+                let replacement = if replace_with_symlink {
+                    symlink(&other, &parent).unwrap();
+                    other.clone()
+                } else {
+                    fs::create_dir(&parent).unwrap();
+                    parent.clone()
+                };
+                let replacement_original = replacement.join(path.file_name().unwrap());
+                fs::write(&replacement_original, b"unrelated replacement document").unwrap();
+                // The writable replacement has the SAME document basename and no
+                // sidecar. Pathname-based saving would succeed here, not ENOTDIR.
+                assert!(document.save(&draft).is_err());
+                assert_comments(&draft, &expected_draft);
