+/// Directory-bound document persistence is supported only on Unix platforms.
+/// Repository review mode does not depend on this implementation.
+#[cfg(not(unix))]
+#[derive(Debug)]
+pub struct Document {
+    path: std::path::PathBuf,
+}
+
+#[cfg(not(unix))]
+impl Document {
+    /// Refuse unsupported persistence before reading or creating any sidecar.
+    pub fn open(_path: &std::path::Path) -> anyhow::Result<(Self, crate::model::CommentStore)> {
+        anyhow::bail!("document mode requires Unix directory-relative filesystem operations")
+    }
+
+    /// Preserve the document API on platforms whose document mode is unavailable.
+    pub fn path(&self) -> &std::path::Path {
+        &self.path
+    }
+
+    /// Never fall back to unsafe pathname-based persistence on unsupported systems.
+    pub fn save(&self, _comments: &crate::model::CommentStore) -> anyhow::Result<()> {
+        anyhow::bail!("document mode requires Unix directory-relative filesystem operations")
+    }
+}
