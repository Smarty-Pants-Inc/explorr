+        #[test]
+        fn foreign_comment_files_and_unusable_ranges_are_refused_on_open_and_save() {
+            let dir = tempfile::tempdir().unwrap();
+            let path = original(dir.path());
+            let (document, _) = Document::open(&path).unwrap();
+            let valid = comments(&path);
+            document.save(&valid).unwrap();
+            let old = fs::read(&document.sidecar).unwrap();
+            let mut foreign = valid.get(0).unwrap().clone();
+            foreign.file = "relative.md".into();
+            let mut zero_start = valid.get(0).unwrap().clone();
