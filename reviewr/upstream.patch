+        assert!(parse(&["--file", file]).handoff.is_none());
+        // With the triple FILE is never resolved here: a symlink stays its own spelling
+        // (the document binding then refuses it) and existence is checked only there.
+        let link = root.join("link.md");
+        #[cfg(unix)]
+        std::os::unix::fs::symlink("doc.md", &link).unwrap();
+        let mut linked = vec!["--file", link.to_str().unwrap()];
+        linked.extend(triple);
+        assert_eq!(ok(&linked).unwrap().document, Some(link.clone()));
+        // Any order, with --line anywhere.
+        let reordered = [
+            "--handoff",
+            handoff,
+            "--line",
+            "2",
+            "--expect-file",
+            "3:4",
+            "--file",
