+                assert_eq!(
+                    fs::read(moved.join(path.file_name().unwrap())).unwrap(),
+                    b"original body\n"
+                );
+                assert_eq!(
+                    fs::read(&replacement_original).unwrap(),
+                    b"unrelated replacement document"
+                );
+                assert_eq!(
+                    fs::read_dir(&replacement).unwrap().count(),
+                    1,
+                    "no new lock, temp, or JSON"
