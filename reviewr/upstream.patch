+        assert!(ok(&reordered).is_ok());
+        let mut cases: Vec<Vec<&str>> = Vec::new();
+        // Every partial subset of the triple.
+        for mask in 1..15_u8 {
+            let mut args = vec!["--file", file];
+            for (i, pair) in triple.chunks(2).enumerate() {
+                if mask & (1 << i) != 0 {
+                    args.extend(pair);
+                }
+            }
